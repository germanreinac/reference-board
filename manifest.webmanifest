{
  "name": "Reference Board",
  "short_name": "Ref Board",
  "description": "A reference board for artists: split views onto one infinite canvas.",
  "start_url": "./",
  "scope": "./",
  "display": "standalone",
  "background_color": "#1b1b1d",
  "theme_color": "#1b1b1d",
  "icons": [
    { "src": "icons/192.png", "sizes": "192x192", "type": "image/png", "purpose": "any" },
    { "src": "icons/512.png", "sizes": "512x512", "type": "image/png", "purpose": "any" },
    { "src": "icons/maskable-192.png", "sizes": "192x192", "type": "image/png", "purpose": "maskable" },
    { "src": "icons/maskable-512.png", "sizes": "512x512", "type": "image/png", "purpose": "maskable" }
  ],
  "shortcuts": [
    { "name": "Save photos to a board", "short_name": "Save photos", "url": "./#/add", "icons": [{ "src": "icons/192.png", "sizes": "192x192" }] }
  ],
  "file_handlers": [
    {
      "action": "./",
      "accept": { "application/x-reference-board": [".refboard", ".refboards"] },
      "icons": [{ "src": "icons/192.png", "sizes": "192x192", "type": "image/png" }],
      "launch_type": "single-client"
    }
  ]
}
