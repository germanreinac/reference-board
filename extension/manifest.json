{
  "manifest_version": 3,
  "name": "Reference Board",
  "version": "1.1.0",
  "description": "Send any image, or a captured part of a web page, straight to your Reference Board.",
  "permissions": ["contextMenus", "activeTab", "scripting", "tabs", "storage", "unlimitedStorage"],
  "host_permissions": ["<all_urls>"],
  "background": { "service_worker": "background.js" },
  "action": { "default_popup": "popup.html", "default_title": "Reference Board" },
  "commands": {
    "capture-area": {
      "suggested_key": { "default": "Alt+Shift+S" },
      "description": "Capture part of this page to Reference Board"
    }
  },
  "content_scripts": [
    {
      "matches": ["https://artdirection.io/*", "https://www.artdirection.io/*", "https://germanreinac.github.io/reference-board/*", "http://localhost:8765/*"],
      "js": ["bridge.js"],
      "run_at": "document_idle"
    }
  ],
  "icons": { "16": "icons/16.png", "48": "icons/48.png", "128": "icons/128.png" }
}
